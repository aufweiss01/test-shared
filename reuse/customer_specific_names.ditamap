<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<map xml:lang="de-DE">

  <title>Kundenweit gültige Namen</title>

  <keydef keys="hersteller">
    <topicmeta>
      <keywords>
        <keyword>PrecisionOptics GmbH</keyword>
        <!-- Auftraggeber-Hersteller; kundenweit gültig.
             Referenziert aus: allen Topics, die den Herstellernamen nennen -->
      </keywords>
    </topicmeta>
  </keydef>

  <keydef keys="optiscope_x200">
    <topicmeta>
      <keywords>
        <keyword>OptiScope X200</keyword>
        <!-- Produktname des Operationsmikroskops; Key entspricht dem Produktnamen
             in angepasster Schreibweise. Ermöglicht produktübergreifende Referenzierung.
             Referenziert aus: Topics, die auf das Opmi als Schwesterprodukt verweisen -->
      </keywords>
    </topicmeta>
  </keydef>

</map>