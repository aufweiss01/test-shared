<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA 1.3 Topic//EN" "topic.dtd">

<topic id="warnings" xml:lang="de-DE">

  <title>Warnhinweise</title>

  <body>

    <hazardstatement type="warning" id="warn_schnittstellendoku" product="optiscope_x200">
      <!-- conref-Adresse: warnings.dita#warnings/warn_schnittstellendoku
          Referenziert aus: docs/tasks/t_analyse_aufgabenstellung.dita -->

      <hazardsymbol>
        <image keyref="img_warnsymbol_allgemein"/>
        <alt>Warnsymbol Katze</alt>
      </hazardsymbol>

      <messagepanel>
        <typeofhazard>Fehlfunktion durch unvollständige
        Schnittstellendokumentation</typeofhazard>
        <consequence>Wenn die <term>Navigationsschnittstelle</term> unvollständig
        oder ungenau dokumentiert wird, können bei der Integration von
        <term>Operationsmikroskop</term> und <term>Navigationsgerät</term>
        Fehlfunktionen auftreten.</consequence>
        <howtoavoid>
          <sl>
            <sli>Stellen Sie sicher, dass alle Komponenten der
            <term>Navigationsschnittstelle</term> –
            <term>mechanische Schnittstelle</term> und
            <term>Softwareschnittstelle</term> – vollständig dokumentiert sind.</sli>
            <sli>Lassen Sie die Dokumentation vor der Freigabe prüfen.</sli>
          </sl>
        </howtoavoid>
      </messagepanel>

    </hazardstatement>

  </body>
</topic>