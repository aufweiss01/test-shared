<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">

<topic id="warnings" xml:lang="de-DE">

  <title>Warnhinweise</title>

  <body>

    <note type="warning" id="warn_schnittstellendoku">
    <!-- conref-Adresse: warnings.dita#warnings/warn_schnittstellendoku
         Referenziert aus: docs/tasks/t_analyse_aufgabenstellung.dita -->

      <p outputclass="warning-signal"><b>WARNUNG</b></p>
      <!-- Signalwort gemäß ANSI Z535 -->

      <p outputclass="warning-hazard"><b>Fehlfunktion durch unvollständige Schnittstellendokumentation</b></p>
      <!-- Art der Gefahr -->

      <p outputclass="warning-consequence">Wenn die <term>Navigationsschnittstelle</term>
      unvollständig oder ungenau dokumentiert wird, können bei der Integration von
      <term>Operationsmikroskop</term> und <term>Navigationsgerät</term>
      Fehlfunktionen auftreten.</p>
      <!-- Ursache und Folgen -->

      <ul outputclass="warning-measures">
      <!-- Maßnahmen gemäß ANSI Z535, erweiterbar -->
        <li>Stellen Sie sicher, dass alle Komponenten der
        <term>Navigationsschnittstelle</term> – <term>mechanische Schnittstelle</term>
        und <term>Softwareschnittstelle</term> – vollständig dokumentiert sind.</li>
        <li>Lassen Sie die Dokumentation vor der Freigabe prüfen.</li>
      </ul>

    </note>

  </body>
</topic>